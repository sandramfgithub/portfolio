{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	redir / /es 301
	redir /about /es/about 301
	redir /projects /es/projects 301

	try_files {path} {path}/index.html =404
	file_server {
		disable_canonical_uris
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
